                    <label class="block text-xs text-stone-500 mb-1">Password *</label>
                    <input type="password" name="password" id="login-password-input" placeholder="Enter password" required class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 outline-none focus:border-gold-600">
