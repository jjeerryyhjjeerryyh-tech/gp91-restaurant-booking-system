                <a href="javascript:void(0)" onclick="openPolicyModal()" class="hover:text-gold-300 transition-colors">Dining Policy</a>
                <a href="javascript:void(0)" onclick="switchTab('location')" class="hover:text-gold-300 transition-colors">Location & Map</a>
                <a href="/my-bookings" class="hover:text-gold-300 transition-colors">My Bookings</a>
