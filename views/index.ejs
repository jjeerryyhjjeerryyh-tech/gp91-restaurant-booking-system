                <div class="flex justify-between items-center pt-2">
                    <button type="button" id="modal-logout-btn" onclick="handleLogout()" class="<%= staffAuthenticated ? '' : 'hidden' %> text-xs text-red-600 hover:underline font-medium">Logout Staff Session</button>
                    <button type="submit" class="ml-auto px-5 py-2.5 rounded-xl bg-obsidian hover:bg-stone-800 text-white text-xs font-medium">Sign In</button>
