                    <label class="block text-xs text-stone-500 mb-1">Email or Phone *</label>
                    <input type="text" required placeholder="+852 91234567" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 outline-none focus:border-gold-600">
                </div>
                <div>
                    <label class="block text-xs text-stone-500 mb-1">Inquiry Details *</label>
                    <textarea rows="3" required placeholder="Tell us about your event date, party size, or questions..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 outline-none focus:border-gold-600"></textarea>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeInquiryModal()" class="px-4 py-2 rounded-xl border border-stone-200 text-xs">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-obsidian hover:bg-stone-800 text-white text-xs font-medium">Send Inquiry</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL 3: Edit Booking Modal (Staff CRUD Update) ==================== -->
