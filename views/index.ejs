                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeEditModal()" class="px-4 py-2 rounded-xl border border-stone-200 text-xs">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-gold-600 hover:bg-gold-700 text-white text-xs font-medium">Save Changes (PUT)</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL 4: Custom Delete Confirmation Modal (Staff) ==================== -->
    <div id="delete-confirm-modal" class="fixed inset-0 z-50 hidden bg-obsidian/70 backdrop-blur-sm flex items-center justify-center p-4">
