    <!-- Global Toast Notification -->
    <div id="toast-notification" class="fixed bottom-6 right-6 z-50 hidden bg-obsidian text-white px-5 py-3.5 rounded-xl shadow-2xl border border-gold-500/40 flex items-center gap-3 text-xs sm:text-sm">
