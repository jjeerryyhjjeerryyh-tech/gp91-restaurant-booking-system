<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>L'ÉCLAT | Contemporary French Cuisine - Online Reservation System</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cormorant Garamond (Luxury Serif) & Inter (Clean Sans-Serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            50: '#fbf8f1',
                            100: '#f5eedc',
                            200: '#eadab8',
                            300: '#dec08d',
                            400: '#d0a361',
                            500: '#c58f42',
                            600: '#b07634',
                            700: '#8f5b2c',
                        },
                        obsidian: '#121316',
                        charcoal: '#1c1e22',
                        alabaster: '#f9f8f6'
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'serif'],
                        sans: ['"Inter"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f9f8f6;
            color: #121316;
        }
        .font-luxury {
            font-family: 'Cormorant Garamond', serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #d0a361;
            border-radius: 3px;
        }
        .card-shadow {
            box-shadow: 0 10px 30px -5px rgba(18, 19, 22, 0.05);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased selection:bg-gold-200 selection:text-obsidian">

    <!-- Top Navigation Bar (Server-rendered EJS State + Interactive Tabs) -->
    <header class="sticky top-0 z-40 bg-alabaster/90 backdrop-blur-md border-b border-stone-200/80 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('booking')">
                <div class="w-10 h-10 rounded-full bg-obsidian text-gold-300 flex items-center justify-center font-luxury text-2xl tracking-wider border border-gold-400/40">
                    L
                </div>
                <div>
                    <span class="font-luxury text-2xl sm:text-3xl font-semibold tracking-widest text-obsidian block leading-none">L'ÉCLAT</span>
                    <span class="text-[10px] tracking-[0.25em] uppercase text-stone-500 block mt-0.5">Fine Dining & Wine</span>
                </div>
            </div>

            <!-- Desktop Navigation Links -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-stone-600">
                <button onclick="switchTab('booking')" id="nav-booking" class="nav-btn <%= activeTab === 'booking' ? 'text-obsidian border-b-2 border-gold-600 font-semibold' : 'hover:text-obsidian' %> py-1 transition-colors">Reservations</button>
                <button onclick="switchTab('menu')" id="nav-menu" class="nav-btn <%= activeTab === 'menu' ? 'text-obsidian border-b-2 border-gold-600 font-semibold' : 'hover:text-obsidian' %> py-1 transition-colors">Culinary Showcase</button>
                <button onclick="switchTab('location')" id="nav-location" class="nav-btn <%= activeTab === 'location' ? 'text-obsidian border-b-2 border-gold-600 font-semibold' : 'hover:text-obsidian' %> py-1 transition-colors">Location & Contact</button>
                <button onclick="switchTab('manage')" id="nav-manage" class="nav-btn <%= activeTab === 'manage' ? 'text-obsidian border-b-2 border-gold-600 font-semibold' : 'hover:text-obsidian' %> py-1 transition-colors flex items-center gap-1.5">
                    <span><%= staffAuthenticated ? 'Staff Dashboard' : 'My Bookings / Staff' %></span>
                    <span id="booking-count-badge" class="bg-gold-100 text-gold-700 text-xs px-2 py-0.5 rounded-full font-semibold"><%= initialBookings.length %></span>
                </button>
            </nav>

            <!-- Staff Authentication Status (Synced with Express Cookie-Session) -->
            <div class="flex items-center space-x-4">
                <div id="user-logged-in" onclick="toggleLoginModal()" class="cursor-pointer flex items-center space-x-2.5 bg-white px-3.5 py-1.5 rounded-full border border-stone-200 hover:border-gold-500 shadow-sm transition-all">
                    <div id="auth-status-dot" class="w-2 h-2 rounded-full <%= staffAuthenticated ? 'bg-emerald-500' : 'bg-stone-400' %>"></div>
                    <span class="text-xs font-medium text-stone-700" id="current-username"><%= staffAuthenticated ? 'Staff: ' + staffName : 'Staff Login' %></span>
                    <i id="auth-status-icon" class="fa-solid <%= staffAuthenticated ? 'fa-arrow-right-from-bracket' : 'fa-right-to-bracket' %> text-xs text-stone-400"></i>
                </div>
                <button onclick="toggleMobileMenu()" class="md:hidden text-obsidian p-2 rounded-lg hover:bg-stone-200/50">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Dropdown Navigation -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-stone-200 px-4 pt-2 pb-4 space-y-2">
            <button onclick="switchTab('booking'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium bg-gold-50 text-gold-700">Reservations</button>
            <button onclick="switchTab('menu'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-stone-600 hover:bg-stone-50">Culinary Showcase</button>
            <button onclick="switchTab('location'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-stone-600 hover:bg-stone-50">Location & Contact</button>
            <button onclick="switchTab('manage'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-stone-600 hover:bg-stone-50"><%= staffAuthenticated ? 'Staff Dashboard' : 'My Bookings / Staff' %></button>
        </div>
    </header>

    <!-- Minimalist Hero Banner -->
    <section class="relative bg-obsidian text-alabaster overflow-hidden py-12 sm:py-16 border-b border-gold-600/20">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#d0a361_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-400/30 text-gold-300 text-xs tracking-widest uppercase mb-3">
                    <i class="fa-solid fa-star text-[10px]"></i> Michelin Guide Selected 2026
                </div>
                <h1 class="font-luxury text-3xl sm:text-5xl font-normal tracking-wide text-white">
                    A Symphony of Light & French Gastronomy
                </h1>
                <p class="text-stone-400 text-sm sm:text-base mt-2 max-w-2xl font-light">
                    Perched high above Central Hong Kong, our culinary team crafts seasonal French delicacies with modern artistry. Select your preferred time and table below.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
                <button onclick="switchTab('menu')" class="px-5 py-2.5 rounded-lg border border-stone-600 hover:border-gold-400 text-stone-200 hover:text-gold-300 text-xs tracking-widest uppercase transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-utensils"></i> View Dishes
                </button>
                <button onclick="openInquiryModal()" class="px-5 py-2.5 rounded-lg bg-gold-600/20 border border-gold-500/40 text-gold-300 hover:bg-gold-600 hover:text-white text-xs tracking-widest uppercase transition-all flex items-center justify-center gap-2">
                    <i class="fa-regular fa-comment-dots"></i> Contact Concierge
                </button>
            </div>
        </div>
    </section>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

        <!-- ==================== TAB 1: Online Reservation Flow (4 Steps) ==================== -->
        <div id="tab-booking" class="<%= activeTab === 'booking' ? '' : 'hidden' %> space-y-8">

            <!-- Progress Stepper -->
            <div class="max-w-3xl mx-auto">
                <div class="grid grid-cols-4 gap-2 sm:gap-4">
                    <div id="step-ind-1" class="border-t-2 border-gold-600 pt-3 transition-all">
                        <span class="text-[11px] uppercase tracking-widest text-gold-600 font-semibold block">Step 01</span>
                        <span class="text-xs sm:text-sm font-medium text-obsidian mt-0.5 block">Table & Time</span>
                    </div>
                    <div id="step-ind-2" class="border-t-2 border-stone-200 pt-3 transition-all">
                        <span class="text-[11px] uppercase tracking-widest text-stone-400 font-semibold block">Step 02</span>
                        <span class="text-xs sm:text-sm font-medium text-stone-400 mt-0.5 block">Guest Details</span>
                    </div>
                    <div id="step-ind-3" class="border-t-2 border-stone-200 pt-3 transition-all">
                        <span class="text-[11px] uppercase tracking-widest text-stone-400 font-semibold block">Step 03</span>
                        <span class="text-xs sm:text-sm font-medium text-stone-400 mt-0.5 block">Review & Payment</span>
                    </div>
                    <div id="step-ind-4" class="border-t-2 border-stone-200 pt-3 transition-all">
                        <span class="text-[11px] uppercase tracking-widest text-stone-400 font-semibold block">Step 04</span>
                        <span class="text-xs sm:text-sm font-medium text-stone-400 mt-0.5 block">Confirmation</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

                <!-- Left/Main Column: Interactive Step Panels (8 Cols) -->
                <div class="lg:col-span-8 bg-white rounded-2xl border border-stone-200/80 p-6 sm:p-8 card-shadow">

                    <!-- [STEP 1: Select Guests, Date, Time, and Seating Zone] -->
                    <div id="booking-step-1" class="space-y-8">
                        <div class="border-b border-stone-100 pb-4 flex items-center justify-between">
                            <div>
                                <h2 class="font-luxury text-2xl sm:text-3xl font-semibold text-obsidian">Reserve Your Table</h2>
                                <p class="text-xs sm:text-sm text-stone-500 mt-1">Select party size, date, dining session, and your preferred seating area</p>
                            </div>
                            <span class="text-xs bg-stone-100 text-stone-600 px-3 py-1 rounded-full">Live Availability</span>
                        </div>

                        <!-- 1. Party Size Selection -->
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-3">
                                <i class="fa-solid fa-user-group mr-1.5 text-gold-600"></i> 1. Number of Guests
                            </label>
                            <div class="grid grid-cols-4 sm:grid-cols-8 gap-2.5" id="guest-selector"></div>
                            <p class="text-[11px] text-stone-400 mt-2">* For private dining rooms or parties of 9 or more, please click "Contact Concierge" at the top right.</p>
                        </div>

                        <!-- 2. Date & Service Period Selection -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-2">
                                    <i class="fa-regular fa-calendar mr-1.5 text-gold-600"></i> 2. Preferred Date
                                </label>
                                <input type="date" id="booking-date" onchange="updateSummary()"
                                    class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-gold-600 focus:ring-2 focus:ring-gold-500/20 outline-none text-sm font-medium text-obsidian bg-stone-50/50 transition-all">
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-2">
                                    <i class="fa-regular fa-sun mr-1.5 text-gold-600"></i> Dining Session
                                </label>
                                <div class="grid grid-cols-2 gap-2 bg-stone-100 p-1 rounded-xl">
                                    <button type="button" onclick="selectPeriod('lunch')" id="period-lunch" class="py-2.5 text-xs font-medium rounded-lg transition-all text-stone-600">
                                        Lunch Service
                                    </button>
                                    <button type="button" onclick="selectPeriod('dinner')" id="period-dinner" class="py-2.5 text-xs font-medium rounded-lg transition-all bg-white text-obsidian shadow-sm">
                                        Dinner Service
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Time Slot Selection -->
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-3">
                                <i class="fa-regular fa-clock mr-1.5 text-gold-600"></i> 3. Select Time Slot
                            </label>
                            <div class="grid grid-cols-3 sm:grid-cols-4 gap-3" id="time-selector"></div>
                        </div>

                        <!-- 4. Seating Zone & Interactive Floor Plan -->
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold">
                                    <i class="fa-solid fa-chair mr-1.5 text-gold-600"></i> 4. Select Seating Zone & Table
                                </label>
                                <span class="text-xs text-gold-700 font-medium">Select a zone card below</span>
                            </div>

                            <div class="bg-stone-900 text-stone-200 p-5 rounded-2xl mb-4 relative overflow-hidden border border-stone-800">
                                <div class="flex items-center justify-between text-[11px] text-stone-400 border-b border-stone-800 pb-2 mb-4">
                                    <span><i class="fa-solid fa-compass mr-1 text-gold-400"></i> Dining Room Floor Plan</span>
                                    <div class="flex items-center gap-4">
                                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-gold-500 inline-block"></span> Selected</span>
                                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-stone-700 border border-stone-500 inline-block"></span> Available</span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-4 gap-3 text-center">
                                    <div onclick="selectSeat('Harbour View Window (Table W1)', 'window', 500)" id="seat-card-window" class="seat-option cursor-pointer p-3.5 rounded-xl border border-gold-500 bg-gold-500/15 transition-all text-left flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs font-semibold text-gold-300">Harbour View Window</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-gold-500/20 text-gold-300">Popular</span>
                                            </div>
                                            <p class="text-[11px] text-stone-400 mt-1">Panoramic Victoria Harbour skyline views, ideal for celebrations</p>
                                        </div>
                                        <div class="mt-3 pt-2 border-t border-stone-800 flex justify-between items-center text-[11px]">
                                            <span class="text-stone-300">Tables: W1 - W4</span>
                                            <span class="text-gold-400 font-medium">HK$500/guest</span>
                                        </div>
                                    </div>

                                    <div onclick="selectSeat('Main Dining Booth (Table M3)', 'main', 300)" id="seat-card-main" class="seat-option cursor-pointer p-3.5 rounded-xl border border-stone-700 bg-stone-800/60 hover:border-stone-500 transition-all text-left flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs font-semibold text-white">Main Dining Booth</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-stone-700 text-stone-300">Spacious</span>
                                            </div>
                                            <p class="text-[11px] text-stone-400 mt-1">Elegant velvet banquets beneath crystal chandeliers</p>
                                        </div>
                                        <div class="mt-3 pt-2 border-t border-stone-700/60 flex justify-between items-center text-[11px]">
                                            <span class="text-stone-300">Tables: M1 - M8</span>
                                            <span class="text-stone-300 font-medium">HK$300/guest</span>
                                        </div>
                                    </div>

                                    <div onclick="selectSeat('Chef\'s Kitchen Counter (Seat C2)', 'counter', 500)" id="seat-card-counter" class="seat-option cursor-pointer p-3.5 rounded-xl border border-stone-700 bg-stone-800/60 hover:border-stone-500 transition-all text-left flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs font-semibold text-white">Chef's Counter</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-stone-700 text-stone-300">Interactive</span>
                                            </div>
                                            <p class="text-[11px] text-stone-400 mt-1">Front-row seats to witness culinary artistry and plating</p>
                                        </div>
                                        <div class="mt-3 pt-2 border-t border-stone-700/60 flex justify-between items-center text-[11px]">
                                            <span class="text-stone-300">Seats: C1 - C6</span>
                                            <span class="text-stone-300 font-medium">HK$500/guest</span>
                                        </div>
                                    </div>

                                    <div onclick="selectSeat('Starlight Garden Terrace (Table T2)', 'terrace', 300)" id="seat-card-terrace" class="seat-option cursor-pointer p-3.5 rounded-xl border border-stone-700 bg-stone-800/60 hover:border-stone-500 transition-all text-left flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs font-semibold text-white">Garden Terrace</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-stone-700 text-stone-300">Al Fresco</span>
                                            </div>
                                            <p class="text-[11px] text-stone-400 mt-1">Semi-outdoor botanical lounge with evening breeze</p>
                                        </div>
                                        <div class="mt-3 pt-2 border-t border-stone-700/60 flex justify-between items-center text-[11px]">
                                            <span class="text-stone-300">Tables: T1 - T4</span>
                                            <span class="text-stone-300 font-medium">HK$300/guest</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Next Step Button -->
                        <div class="pt-4 flex justify-end">
                            <button type="button" onclick="openPolicyModal()" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-obsidian hover:bg-stone-800 text-white font-medium text-sm tracking-wider uppercase transition-all flex items-center justify-center gap-3 shadow-lg shadow-obsidian/10">
                                <span>Next: Dining Policy</span>
                                <i class="fa-solid fa-arrow-right text-gold-400"></i>
                            </button>
                        </div>
                    </div>

                    <!-- [STEP 2: Guest Contact Information with Strict Region Phone & Email Validation] -->
                    <div id="booking-step-2" class="hidden space-y-6">
                        <div class="border-b border-stone-100 pb-4 flex items-center justify-between">
                            <div>
                                <h2 class="font-luxury text-2xl sm:text-3xl font-semibold text-obsidian">Guest Information</h2>
                                <p class="text-xs sm:text-sm text-stone-500 mt-1">Please enter valid contact details to receive instant email confirmation & look up bookings</p>
                            </div>
                            <button type="button" onclick="goToStep(1)" class="text-xs text-stone-500 hover:text-obsidian flex items-center gap-1">
                                <i class="fa-solid fa-chevron-left"></i> Back to Time & Seat
                            </button>
                        </div>

                        <form id="guest-info-form" onsubmit="handleStep2Submit(event)" novalidate class="space-y-6">
                            <!-- Salutation / Title -->
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-2.5">Salutation / Title *</label>
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                    <label class="cursor-pointer">
                                        <input type="radio" name="salutation" value="Mr." checked class="peer sr-only" onchange="updateSummary()">
                                        <div class="py-2.5 px-4 text-center rounded-xl border border-stone-200 text-sm font-medium text-stone-600 peer-checked:border-gold-600 peer-checked:bg-gold-50/60 peer-checked:text-obsidian transition-all">
                                            Mr. (Male)
                                        </div>
                                    </label>
                                    <label class="cursor-pointer">
                                        <input type="radio" name="salutation" value="Ms." class="peer sr-only" onchange="updateSummary()">
                                        <div class="py-2.5 px-4 text-center rounded-xl border border-stone-200 text-sm font-medium text-stone-600 peer-checked:border-gold-600 peer-checked:bg-gold-50/60 peer-checked:text-obsidian transition-all">
                                            Ms. (Female)
                                        </div>
                                    </label>
                                    <label class="cursor-pointer">
                                        <input type="radio" name="salutation" value="Miss" class="peer sr-only" onchange="updateSummary()">
                                        <div class="py-2.5 px-4 text-center rounded-xl border border-stone-200 text-sm font-medium text-stone-600 peer-checked:border-gold-600 peer-checked:bg-gold-50/60 peer-checked:text-obsidian transition-all">
                                            Miss (Female)
                                        </div>
                                    </label>
                                    <label class="cursor-pointer">
                                        <input type="radio" name="salutation" value="Dr." class="peer sr-only" onchange="updateSummary()">
                                        <div class="py-2.5 px-4 text-center rounded-xl border border-stone-200 text-sm font-medium text-stone-600 peer-checked:border-gold-600 peer-checked:bg-gold-50/60 peer-checked:text-obsidian transition-all">
                                            Dr. / Prof.
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Last Name & First Name -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-2">Last Name (Surname) *</label>
                                    <input type="text" id="guest-lastname" required maxlength="40" placeholder="e.g., Chan" oninput="validateNameField('guest-lastname', 'err-lastname'); updateSummary()"
                                        class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-gold-600 focus:ring-2 focus:ring-gold-500/20 outline-none text-sm transition-all">
                                    <p id="err-lastname" class="hidden text-[11px] text-red-600 mt-1.5 flex items-center gap-1">
                                        <i class="fa-solid fa-circle-exclamation"></i> <span>Please enter a valid last name (letters only).</span>
                                    </p>
                                </div>
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-2">First Name (Given Name) *</label>
                                    <input type="text" id="guest-firstname" required maxlength="40" placeholder="e.g., Alex" oninput="validateNameField('guest-firstname', 'err-firstname'); updateSummary()"
                                        class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-gold-600 focus:ring-2 focus:ring-gold-500/20 outline-none text-sm transition-all">
                                    <p id="err-firstname" class="hidden text-[11px] text-red-600 mt-1.5 flex items-center gap-1">
                                        <i class="fa-solid fa-circle-exclamation"></i> <span>Please enter a valid first name (letters only).</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Phone Number (Strict Region Digit Limit) & Email Address (Strict Format) -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-stone-500 font-semibold mb-2">Phone Number (Region Validated) *</label>
                                    <div id="phone-input-wrapper" class="flex rounded-xl border border-stone-200 focus-within:border-gold-600 focus-within:ring-2 focus-within:ring-gold-500/20 overflow-hidden bg-white transition-all">
