                    <div>
                        <label class="block text-xs text-stone-500 mb-1">Party Size *</label>
                        <input type="number" id="edit-guests" min="1" max="20" required class="w-full px-3 py-2 rounded-xl border border-stone-200">
                    </div>
                </div>
                <div>
                    <label class="block text-xs text-stone-500 mb-1">Table / Seating Zone *</label>
                    <input type="text" id="edit-table" required class="w-full px-3 py-2 rounded-xl border border-stone-200">
                </div>
                <div>
